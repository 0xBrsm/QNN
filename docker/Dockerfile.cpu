# qnn-cpu — the CPU work-horse image (collects, aimgrid/arena evals, decode-fit
# campaigns, human-band scoring). Third role in the container split:
#   devcontainer  = interactive dev (16 GiB cgroup; rebuilt freely)
#   trainer       = GPU training only (ROCm; resident daemon, protected)
#   qnn-cpu       = detached CPU jobs with their own cpu/mem budget
# Rationale: the devcontainer rebuild lifecycle drops runtime deps (torch lives
# in the [train] extra the post-start hook skips), and wide jobs pin its 16 GiB
# cap (silent exit-137 worker kills). This image pins the runtime slice.
#
# The repo is BIND-MOUNTED at /workspace (same convention as the trainer);
# qnn is imported via PYTHONPATH=/workspace/src set by the shared entrypoint —
# no editable install baked into the image. Engine binaries (qw_demo_worker,
# eval bridge) are glibc-only (libstdc++/libm) but built on Ubuntu 24.04 and
# need GLIBC >= 2.38 — hence trixie (2.41), not bookworm (2.36).
FROM python:3.12-slim-trixie

ARG USERNAME=worker
ARG USER_UID=1000
ARG USER_GID=1000

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        less \
        procps \
        rsync \
        sudo \
    && rm -rf /var/lib/apt/lists/* \
    && if ! getent group "${USER_GID}" >/dev/null; then groupadd --gid "${USER_GID}" "${USERNAME}"; fi \
    && useradd --uid "${USER_UID}" --gid "${USER_GID}" -m -s /bin/bash "${USERNAME}" \
    && usermod -aG sudo "${USERNAME}" \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" \
    && chmod 0440 "/etc/sudoers.d/${USERNAME}"

# CPU torch from the pytorch CPU index (no CUDA/ROCm payload); the rest are the
# runtime deps of the analysis/eval/decode-fit stack (pyproject [dev,corpus]
# extras + the band/export tooling). numpy 2.x matches the analysis stack
# (the trainer's 1.26 pin is a sample-factory constraint that does not apply here).
RUN python3 -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        "torch==2.13.0" \
    && python3 -m pip install --no-cache-dir \
        "numpy>=2.0.0" \
        "scipy>=1.14" \
        "onnx>=1.22" \
        "onnxruntime>=1.20" \
        "onnxsim" \
        "pytest>=8.0.0" \
        "smbprotocol>=1.10.0" \
        "warcio>=1.7.0"

WORKDIR /workspace

COPY src/docker/entrypoint.sh /usr/local/bin/qnn-cpu-entrypoint
RUN chmod +x /usr/local/bin/qnn-cpu-entrypoint

USER ${USERNAME}

ENTRYPOINT ["qnn-cpu-entrypoint"]
CMD ["bash"]

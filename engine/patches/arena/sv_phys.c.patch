 //============================================================================
 
+// QNN: fixed edict-index order gives the lower client slot a systematic
+// same-frame edge over higher slots (it moves/fires first every tick, and
+// can silence a higher slot's return fire on a mid-frame kill).  SV_Physics
+// below walks client edicts in a freshly shuffled order each frame instead.
+//
+// xorshift32, not rand()/random(): the QC random() builtin drains the same
+// libc rand() stream, and this runs every server frame regardless of QC
+// activity, so pulling from rand() here would perturb random()'s sequence
+// out from under gameplay scripts.
+#define QNN_SHUFFLE_MAX 64
+
+static unsigned int qnn_shuffle_rng_state = 0x9e3779b9u;
+
+static unsigned int QNN_ShuffleRandom (void)
+{
+	unsigned int x = qnn_shuffle_rng_state;
+	x ^= x << 13;
+	x ^= x >> 17;
+	x ^= x << 5;
+	qnn_shuffle_rng_state = x;
+	return x;
+}
+
+// Fisher-Yates over order[0..n-1].
+static void QNN_ShuffleClientOrder (int *order, int n)
+{
+	int i, j, tmp;
+
+	for (i = n - 1; i > 0; i--)
+	{
+		j = (int)(QNN_ShuffleRandom () % (unsigned int)(i + 1));
+		tmp = order[i];
+		order[i] = order[j];
+		order[j] = tmp;
+	}
+}
+
+// Stock non-client movetype dispatch, shared verbatim by the world edict
+// (pass A) and the post-client edicts (pass C).
+static void QNN_Physics_NonClient (edict_t *ent)
+{
+	if (ent->v.movetype == MOVETYPE_PUSH)
+		SV_Physics_Pusher (ent);
+	else if (ent->v.movetype == MOVETYPE_NONE)
+		SV_Physics_None (ent);
+#ifdef QUAKE2
+	else if (ent->v.movetype == MOVETYPE_FOLLOW)
+		SV_Physics_Follow (ent);
+#endif
+	else if (ent->v.movetype == MOVETYPE_NOCLIP)
+		SV_Physics_Noclip (ent);
+	else if (ent->v.movetype == MOVETYPE_STEP)
+		SV_Physics_Step (ent);
+	else if (ent->v.movetype == MOVETYPE_TOSS
+	|| ent->v.movetype == MOVETYPE_BOUNCE
+#ifdef QUAKE2
+	|| ent->v.movetype == MOVETYPE_BOUNCEMISSILE
+#endif
+	|| ent->v.movetype == MOVETYPE_FLY
+	|| ent->v.movetype == MOVETYPE_FLYMISSILE)
+		SV_Physics_Toss (ent);
+	else
+		Sys_Error ("SV_Physics: bad movetype %i", (int)ent->v.movetype);
+}

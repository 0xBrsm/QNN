# host_cmd.c — keep player netname strings inside the progs heap on 64-bit
#
# Player names stored in client_t live outside pr_strings, so subtracting
# pr_strings from host_client->name truncates on 64-bit. Copy the text into the
# progs heap with ED_NewString() first.
#
--- host_cmd.c
+++ host_cmd.c
@@ -936,7 +936,7 @@
 		if (Q_strcmp(host_client->name, newName) != 0)
 			Con_Printf ("%s renamed to %s\n", host_client->name, newName);
 	Q_strcpy (host_client->name, newName);
-	host_client->edict->v.netname = host_client->name - pr_strings;
+	host_client->edict->v.netname = ED_NewString (host_client->name) - pr_strings;
 	
 // send notification to all clients
 		
@@ -1308,7 +1308,7 @@
 		memset (&ent->v, 0, progs->entityfields * 4);
 		ent->v.colormap = NUM_FOR_EDICT(ent);
 		ent->v.team = (host_client->colors & 15) + 1;
-		ent->v.netname = host_client->name - pr_strings;
+		ent->v.netname = ED_NewString (host_client->name) - pr_strings;
 
 		// copy spawn parms out of the client_t
 

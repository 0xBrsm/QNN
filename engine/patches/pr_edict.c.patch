# pr_edict.c — snprintf hardening for value/global string helpers
#
# PR_ValueString(), PR_UglyValueString(), and PR_GlobalString() format progs
# strings into fixed-size buffers with sprintf. Use snprintf instead.
#
--- pr_edict.c
+++ pr_edict.c
@@ -464,7 +464,7 @@
 	switch (type)
 	{
 	case ev_string:
-		sprintf (line, "%s", pr_strings + val->string);
+		snprintf (line, sizeof(line), "%s", pr_strings + val->string);
 		break;
 	case ev_entity:	
 		sprintf (line, "entity %i", NUM_FOR_EDICT(PROG_TO_EDICT(val->edict)) );
@@ -504,7 +504,7 @@
 	switch (type)
